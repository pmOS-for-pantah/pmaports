maintainer="sidharthify <wednisegit@gmail.com>"
pkgname=soc-google-gs201
pkgver=1
pkgrel=1
pkgdesc="Common files for gs201"
url="https://postmarketos.org"
depends="postmarketos-mkinitfs devicepkg-utils devmem2"
source="
	20-devmem.files
	00-enable-fb.sh
	80-soc-google-gs201.preset
	gs201-mark-boot-successful
	gs201-mark-boot-successful.service
	"
arch="aarch64"
license="BSD-3-Clause"
options="!check !archcheck !tracedeps"

package() {
	install -Dm644 "$srcdir"/20-devmem.files \
		"$pkgdir"/usr/share/mkinitfs/files/20-devmem.files
	install -Dm644 "$srcdir"/00-enable-fb.sh \
	-t "$pkgdir"/usr/share/mkinitfs/hooks/
	install -Dm755 "$srcdir"/gs201-mark-boot-successful \
		-t "$pkgdir"/usr/libexec/
	install -Dm644 "$srcdir"/gs201-mark-boot-successful.service \
		-t "$pkgdir"/usr/lib/systemd/system/
	install -Dm644 "$srcdir"/80-soc-google-gs201.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset/
}

