maintainer="sidharthify <wednisegit@gmail.com>"
pkgname=device-google-panther
pkgdesc="Google Pixel 7"
pkgver=1
pkgrel=3
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	android-tools
	linux-postmarketos-gs201
	postmarketos-base
	soc-google-gs201
"
makedepends="
	android-tools
	devicepkg-dev
	dtc
"
subpackages="$pkgname-nonfree-firmware:nonfree_firmware"
source="
	deviceinfo
	dtboimg.cfg
	gs201-panther-mp.dts
	kernel-cmdline.conf
"

build() {
	devicepkg_build $startdir $pkgname

	cd "$srcdir"
	dtc -O dtb -o gs201-panther-mp.dtbo -@ gs201-panther-mp.dts
	mkdtboimg cfg_create dtbo.img dtboimg.cfg
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/dtbo.img "$pkgdir"/boot/dtbo.img
}

nonfree_firmware() {
	pkgdesc="Mali GPU firmware"
	depends="linux-firmware-arm"
	mkdir "$subpkgdir"
}

