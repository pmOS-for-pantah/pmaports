diff --git a/js/ui/status/flashlight.js b/js/ui/status/flashlight.js
new file mode 100644
index 0000000..f9b2551
--- /dev/null
+++ b/js/ui/status/flashlight.js
@@ -0,0 +1,102 @@
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+
+import {QuickToggle, SystemIndicator} from '../quickSettings.js';
+
+const LEDS_PATH = '/sys/class/leds';
+
+function findFlashLed() {
+    const dir = Gio.File.new_for_path(LEDS_PATH);
+    let enumerator;
+
+    try {
+        enumerator = dir.enumerate_children('standard::name',
+            Gio.FileQueryInfoFlags.NONE, null);
+    } catch {
+        return null;
+    }
+
+    let info;
+    while ((info = enumerator.next_file(null))) {
+        const name = info.get_name();
+
+        if (name.endsWith(':flash') || name.endsWith(':torch'))
+            return name;
+    }
+
+    return null;
+}
+
+function readLedAttribute(name, attribute) {
+    try {
+        const file = Gio.File.new_for_path(`${LEDS_PATH}/${name}/${attribute}`);
+        const [, contents] = file.load_contents(null);
+
+        return parseInt(new TextDecoder().decode(contents), 10);
+    } catch {
+        return 0;
+    }
+}
+
+const FlashlightToggle = GObject.registerClass(
+class FlashlightToggle extends QuickToggle {
+    _init(ledName) {
+        super._init({
+            title: _('Flashlight'),
+            iconName: 'flashlight-symbolic',
+        });
+
+        this._ledName = ledName;
+        this._maxBrightness = readLedAttribute(ledName, 'max_brightness');
+
+        this.connect('clicked', () => this._toggle());
+        this._sync();
+    }
+
+    _toggle() {
+        const brightness = this.checked ? 0 : this._maxBrightness;
+
+        Gio.DBus.system.call(
+            'org.freedesktop.login1',
+            '/org/freedesktop/login1/session/auto',
+            'org.freedesktop.login1.Session',
+            'SetBrightness',
+            new GLib.Variant('(ssu)', ['leds', this._ledName, brightness]),
+            null, Gio.DBusCallFlags.NONE, -1, null,
+            (connection, result) => {
+                try {
+                    connection.call_finish(result);
+                } catch (e) {
+                    logError(e, 'Failed to set flashlight brightness');
+                }
+
+                this._sync();
+            });
+    }
+
+    vfunc_map() {
+        super.vfunc_map();
+        this._sync();
+    }
+
+    _sync() {
+        const checked = readLedAttribute(this._ledName, 'brightness') > 0;
+
+        if (this.checked !== checked)
+            this.set({checked});
+    }
+});
+
+export const Indicator = GObject.registerClass(
+class Indicator extends SystemIndicator {
+    _init() {
+        super._init();
+
+        const ledName = findFlashLed();
+        if (!ledName)
+            return;
+
+        this.quickSettingsItems.push(new FlashlightToggle(ledName));
+    }
+});
